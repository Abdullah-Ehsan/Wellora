@model Wellora.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Contact";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/Contact.css" />

<div class="container contact-page">
    <!-- Contact Info Header -->
    <h2 class="section-title">Contact Info</h2>

    <!-- Info Section -->
    <div class="row align-items-center info-section">
        <!-- Left: Character Image -->
        <div class="col-md-4 text-center">
            <img src="~/images/Contact/cythnia_as_doctor.png" alt="Character" class="img-fluid character-img" />
        </div>

        <!-- Right: Contact Details -->
        <div class="col-md-8 contact-details">
            <div class="info-item">
                <i class="fas fa-phone fa-2x icon"></i>
                <span>@Model.Phone</span>
            </div>
            <div class="info-item">
                <i class="fas fa-envelope fa-2x icon"></i>
                <span>@Model.Email</span>
            </div>
            <div class="info-item">
                <i class="fas fa-map-marker-alt fa-2x icon"></i>
                <span>@Model.Address</span>
            </div>
        </div>
    </div>

    <!-- Google Map -->
    <div class="map-section mt-4">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3383.123456!2d74.533!3d32.492!..."
                width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy">
        </iframe>
    </div>

    <!-- Contact Form -->
    <h2 class="section-title mt-5">Contact Form</h2>
    <form asp-action="SendMessage" method="post" class="contact-form">
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Form.FirstName"></label>
                <input asp-for="Form.FirstName" class="form-control" />
                <span asp-validation-for="Form.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Form.LastName"></label>
                <input asp-for="Form.LastName" class="form-control" />
                <span asp-validation-for="Form.LastName" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Form.Email"></label>
            <input asp-for="Form.Email" class="form-control" />
            <span asp-validation-for="Form.Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Form.Message"></label>
            <textarea asp-for="Form.Message" class="form-control message-box"></textarea>
            <span asp-validation-for="Form.Message" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-teal">Send</button>
    </form>

    <!-- Newsletter -->
    <h2 class="section-title mt-5">Newsletter</h2>
    <form asp-action="Subscribe" method="post" class="newsletter-form">
        <div class="form-row align-items-end">
            <div class="form-group col-md-9">
                <input type="email" name="NewsletterEmail" class="form-control" placeholder="Enter your Gmail" required />
            </div>
            <div class="form-group col-md-3">
                <button type="submit" class="btn btn-teal btn-block">Subscribe</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
