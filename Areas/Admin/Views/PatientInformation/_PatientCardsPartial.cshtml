@using Wellora.Areas.Admin.ViewModels.PatientInformation
@model PatientListingViewModel

<div class="row" id="patientCards">
    @if (Model.Patients != null)
    {
        @foreach (var patient in Model.Patients)
        {
            <div class="col-md-3">
                <div class="card doctor-card">
                    <img src="@(string.IsNullOrEmpty(patient.ProfilePhoto)
                                                      ? Url.Content("~/User/Patient/Profile_Picture/Default.png")
                                                      : Url.Content("~/" + patient.ProfilePhoto))"
                 alt="Patient Avatar" class="doctor-img" />

                    <div class="card-body">
                        <h5 class="card-title">
                            @(patient.FullName?.Split(new[] { ' ', '_', '-' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Patient")
                        </h5>

                        <p class="card-text">Gender: @(patient.Gender ?? "N/A")</p>
                        <a asp-area="Admin" asp-controller="PatientInformation" asp-action="PatientDetail" asp-route-id="@patient.PatientId"
                           class="btn btn-primary">
                            View
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.TotalPages > 1)
{
    var startPage = Math.Max(1, Model.CurrentPage - 1);
    var endPage = Math.Min(Model.TotalPages, startPage + 2);

    // If we're near the end, move the window back
    // so that we still show 3 pages.
    if (endPage - startPage < 2)
    {
        startPage = Math.Max(1, endPage - 2);
    }

    <nav aria-label="Patient listing pagination">
        <ul class="pagination justify-content-center" id="pagination">

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       href="javascript:void(0);"
                       onclick="applyFilters(@i)">
                        @i
                    </a>

                </li>
            }

        </ul>
    </nav>
}