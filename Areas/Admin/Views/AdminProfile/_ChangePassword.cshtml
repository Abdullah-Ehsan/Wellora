@model Wellora.Areas.Admin.ViewModels.AdminProfile.ChangePasswordViewModel

<link rel="stylesheet"
      href="~/css/admin/profile/change_password.css"
      asp-append-version="true" />

<div class="admin-profile-info">

    <div class="card admin-profile-card">

        <!-- =========================================================
             HEADER
             ========================================================= -->
        <div class="card-header">

            <div class="d-flex align-items-center gap-2">

                <div class="admin-section-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <div>
                    <h5 class="mb-0">
                        Change Password
                    </h5>

                    <small class="text-muted">
                        Update your password to keep your account secure
                    </small>
                </div>

            </div>

        </div>


        <!-- =========================================================
             BODY
             ========================================================= -->
        <div class="card-body">

            <form method="post"
                  hx-post="@Url.Action(
                                        "ChangePassword",
                                        "AdminProfile",
                                        new { area = "Admin" }
                                    )"
                  hx-target="#profileContent"
                  hx-swap="innerHTML"
                  hx-indicator="#profileLoading">

                @Html.AntiForgeryToken()


                <div class="row g-4">


                    <!-- =================================================
                         CURRENT PASSWORD
                         ================================================= -->
                    <div class="col-12">

                        <label for="currentPassword"
                               class="form-label">

                            Current Password

                        </label>

                        <div class="password-input-wrapper">

                            <input type="password"
                                   id="currentPassword"
                                   name="CurrentPassword"
                                   class="form-control password-input"
                                   autocomplete="current-password"
                                   placeholder="Enter your current password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-password-target="currentPassword"
                                    aria-label="Show current password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================================
                         NEW PASSWORD
                         ================================================= -->
                    <div class="col-12">

                        <label for="newPassword"
                               class="form-label">

                            New Password

                        </label>

                        <div class="password-input-wrapper">

                            <input type="password"
                                   id="newPassword"
                                   name="NewPassword"
                                   class="form-control password-input"
                                   autocomplete="new-password"
                                   placeholder="Enter your new password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-password-target="newPassword"
                                    aria-label="Show new password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>


                        <!-- =============================================
                             PASSWORD REQUIREMENTS
                             ============================================= -->

                        <div class="password-requirements">

                            <div class="password-requirements-title">
                                Password requirements
                            </div>

                            <ul class="password-requirements-list">

                                <li>
                                    <i class="bi bi-check2"></i>
                                    At least 8 characters
                                </li>

                                <li>
                                    <i class="bi bi-check2"></i>
                                    At least one uppercase letter
                                </li>

                                <li>
                                    <i class="bi bi-check2"></i>
                                    At least one number
                                </li>

                                <li>
                                    <i class="bi bi-check2"></i>
                                    At least one special character
                                </li>

                            </ul>

                        </div>

                    </div>


                    <!-- =================================================
                         CONFIRM PASSWORD
                         ================================================= -->
                    <div class="col-12">

                        <label for="confirmNewPassword"
                               class="form-label">

                            Confirm New Password

                        </label>

                        <div class="password-input-wrapper">

                            <input type="password"
                                   id="confirmNewPassword"
                                   name="ConfirmNewPassword"
                                   class="form-control password-input"
                                   autocomplete="new-password"
                                   placeholder="Re-enter your new password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-password-target="confirmNewPassword"
                                    aria-label="Show password confirmation">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmNewPassword"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- =====================================================
                     SECURITY NOTICE
                     ===================================================== -->
                <div class="admin-password-security-notice mt-4">

                    <div class="admin-password-security-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>

                        <div class="admin-password-security-title">
                            Keep your password secure
                        </div>

                        <div class="admin-password-security-text">
                            Do not share your password with anyone.
                            Use a password that you do not use for other accounts.
                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     SAVE BUTTON
                     ===================================================== -->
                <div class="d-flex justify-content-end mt-4">

                    <button type="submit"
                            class="btn admin-save-button">

                        <i class="bi bi-key me-1"></i>

                        Change Password

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<script>

    /*
     * Password visibility toggle.
     *
     * This script works with the HTMX-loaded partial because
     * the event delegation is attached to the document.
     */

    document.addEventListener("click", function (event) {

        const toggle =
            event.target.closest(".password-toggle");

        if (!toggle) {
            return;
        }

        const targetId =
            toggle.getAttribute("data-password-target");

        const passwordInput =
            document.getElementById(targetId);

        if (!passwordInput) {
            return;
        }

        const icon =
            toggle.querySelector("i");

        if (passwordInput.type === "password") {

            passwordInput.type = "text";

            if (icon) {
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            }

            toggle.setAttribute(
                "aria-label",
                "Hide password");

        }
        else {

            passwordInput.type = "password";

            if (icon) {
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }

            toggle.setAttribute(
                "aria-label",
                "Show password");
        }

    });

</script>
