@{
    ViewData["Title"] = "Patient Profile";
}

<link rel="stylesheet" href="~/css/patient/profile/profile.css" asp-append-version="true" />


<div class="container-fluid patient-profile-page">
    <div class="row min-vh-100">


        <!-- =========================================================
             SIDEBAR
             ========================================================= -->
        <aside class="col-12 col-md-3 col-lg-2 patient-profile-sidebar border-end d-flex flex-column p-0">


            <!-- =====================================================
                 SIDEBAR HEADER
                 ===================================================== -->
            <div class="patient-sidebar-header p-3 border-bottom">

                <div class="d-flex align-items-center gap-2">

                    <div class="patient-sidebar-icon">
                        <i class="bi bi-person-circle"></i>
                    </div>

                    <div>

                        <h5 class="mb-0">
                            Patient Profile
                        </h5>

                        <small class="text-muted">
                            Manage your profile
                        </small>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 SIDEBAR NAVIGATION
                 ===================================================== -->
            <nav class="patient-sidebar-navigation flex-grow-1 p-3">

                <div class="patient-sidebar-section-title mb-2">
                    PROFILE SETTINGS
                </div>


                <ul class="nav flex-column gap-1">


                    <!-- =================================================
                         PROFILE INFO
                         ================================================= -->
                    <li class="nav-item">

                        <a href="#"
                           class="nav-link patient-sidebar-link active"
                           data-title="Profile Information"
                           data-description="Manage your personal information, account details and profile information."
                           hx-get="@Url.Action(
                                                             "ProfileInfoPartial",
                                                             "PatientProfile",
                                                             new { area = "Patient" }
                                                         )"
                           hx-target="#profileContent"
                           hx-swap="innerHTML"
                           hx-indicator="#profileLoading"
                           hx-on:click="setPatientProfileSection(this);">

                            <span class="patient-sidebar-link-icon">
                                <i class="bi bi-person"></i>
                            </span>

                            <span>
                                Profile Info
                            </span>

                        </a>

                    </li>


                    <!-- =================================================
                         DOCTOR INFO
                         ================================================= -->
                    <li class="nav-item">

                        <a href="#"
                           class="nav-link patient-sidebar-link"
                           data-title="Doctor Information"
                           data-description="View information about your assigned doctor and healthcare provider."
                           hx-get="@Url.Action(
                                                             "DoctorInfoPartial",
                                                             "PatientProfile",
                                                             new { area = "Patient" }
                                                         )"
                           hx-target="#profileContent"
                           hx-swap="innerHTML"
                           hx-indicator="#profileLoading"
                           hx-on:click="setPatientProfileSection(this);">

                            <span class="patient-sidebar-link-icon">
                                <i class="bi bi-person-badge"></i>
                            </span>

                            <span>
                                Doctor Info
                            </span>

                        </a>

                    </li>


                    <!-- =================================================
                         EMERGENCY CONTACTS
                         ================================================= -->
                    <li class="nav-item">

                        <a href="#"
                           class="nav-link patient-sidebar-link"
                           data-title="Emergency Contacts"
                           data-description="Manage the people who should be contacted in case of an emergency."
                           hx-get="@Url.Action(
                                                             "EmergencyContactsPartial",
                                                             "PatientProfile",
                                                             new { area = "Patient" }
                                                         )"
                           hx-target="#profileContent"
                           hx-swap="innerHTML"
                           hx-indicator="#profileLoading"
                           hx-on:click="setPatientProfileSection(this);">

                            <span class="patient-sidebar-link-icon">
                                <i class="bi bi-telephone"></i>
                            </span>

                            <span>
                                Emergency Contacts
                            </span>

                        </a>

                    </li>


                    <!-- =================================================
                         MEDICAL HISTORY
                         ================================================= -->
                    <li class="nav-item">

                        <a href="#"
                           class="nav-link patient-sidebar-link"
                           data-title="Medical History"
                           data-description="View and manage your medical history, conditions and important health information."
                           hx-get="@Url.Action(
                                                             "MedicalHistoryPartial",
                                                             "PatientProfile",
                                                             new { area = "Patient" }
                                                         )"
                           hx-target="#profileContent"
                           hx-swap="innerHTML"
                           hx-indicator="#profileLoading"
                           hx-on:click="setPatientProfileSection(this);">

                            <span class="patient-sidebar-link-icon">
                                <i class="bi bi-heart-pulse"></i>
                            </span>

                            <span>
                                Medical History
                            </span>

                        </a>

                    </li>


                    <!-- =================================================
                         CHANGE PASSWORD
                         ================================================= -->
                    <li class="nav-item">

                        <a href="#"
                           class="nav-link patient-sidebar-link"
                           data-title="Change Password"
                           data-description="Update your account password to keep your patient account secure."
                           hx-get="@Url.Action(
                                                             "ChangePasswordPartial",
                                                             "PatientProfile",
                                                             new { area = "Patient" }
                                                         )"
                           hx-target="#profileContent"
                           hx-swap="innerHTML"
                           hx-indicator="#profileLoading"
                           hx-on:click="setPatientProfileSection(this);">

                            <span class="patient-sidebar-link-icon">
                                <i class="bi bi-key"></i>
                            </span>

                            <span>
                                Change Password
                            </span>

                        </a>

                    </li>


                </ul>

            </nav>


            <!-- =====================================================
                 SIDEBAR FOOTER
                 ===================================================== -->
            <div class="patient-sidebar-footer border-top p-3">


                <!-- =================================================
                     PATIENT ACCOUNT
                     ================================================= -->
                <div class="patient-sidebar-user mb-3">

                    <div class="d-flex align-items-center gap-2">

                        <div class="patient-user-icon">
                            <i class="bi bi-person"></i>
                        </div>

                        <div class="flex-grow-1">

                            <div class="small fw-semibold">
                                Patient
                            </div>

                            <div class="small text-muted">
                                Account
                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     LOGOUT PARTIAL
                     ================================================= -->
                <div class="patient-logout-container">

                    @await Html.PartialAsync("_PatientLogout")

                </div>

            </div>


        </aside>


        <!-- =========================================================
             MAIN CONTENT
             ========================================================= -->
        <main class="col-12 col-md-9 col-lg-10 patient-profile-content p-0">


            <!-- =====================================================
                 DYNAMIC CONTENT HEADER
                 ===================================================== -->
            <div class="patient-content-header border-bottom px-4 py-3">

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">


                    <!-- =================================================
                         HEADER INFORMATION
                         ================================================= -->
                    <div>

                        <h4 id="profileTitle"
                            class="mb-1">

                            Profile Information

                        </h4>


                        <p id="profileDescription"
                           class="text-muted mb-0">

                            Manage your personal information, account details and profile information.

                        </p>

                    </div>


                    <!-- =================================================
                         LOADING INDICATOR
                         ================================================= -->
                    <div id="profileLoading"
                         class="htmx-indicator">

                        <div class="d-flex align-items-center gap-2 text-muted">

                            <div class="spinner-border spinner-border-sm"
                                 role="status"
                                 aria-hidden="true">
                            </div>

                            <span>
                                Loading...
                            </span>

                        </div>

                    </div>


                </div>

            </div>


            <!-- =====================================================
                 DYNAMIC CONTENT BODY
                 ===================================================== -->
            <div class="patient-content-body p-3 p-md-4">


                <div id="profileContent"
                     hx-get="@Url.Action(
                                                 "ProfileInfoPartial",
                                                 "PatientProfile",
                                                 new { area = "Patient" }
                                             )"
                     hx-trigger="load"
                     hx-target="this"
                     hx-swap="innerHTML"
                     hx-indicator="#profileLoading">


                    <!-- =================================================
                         INITIAL LOADING STATE
                         ================================================= -->
                    <div class="patient-page-loading">

                        <div class="text-center py-5">

                            <div class="spinner-border"
                                 role="status"
                                 aria-hidden="true">
                            </div>

                            <div class="mt-3 text-muted">
                                Loading your profile...
                            </div>

                        </div>

                    </div>


                </div>


            </div>


        </main>


    </div>

</div> <!-- ============================================================= TOAST CONTAINER ============================================================= --> 
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="toastContainer"
         class="toast-container">
    </div>

</div> 
<!-- ============================================================= PATIENT PROFILE NAVIGATION SCRIPT ============================================================= --> 
<script> 
    function setPatientProfileSection(element) 
    { /* * Prevent the "#" from changing the browser URL. */ 
    event.preventDefault(); 
    /* * Remove active state from all sidebar links. */ 
    document .querySelectorAll(".patient-sidebar-link") .forEach(function (link) { link.classList.remove("active"); }); 
    /* * Add active state to the clicked link. */ 
    element.classList.add("active"); 
    /* * Get section information from data attributes. */ 
    const title = element.dataset.title; 
    const description = element.dataset.description; 
    /* * Update main content header. */ 
    const titleElement = document.getElementById("profileTitle"); 
    const descriptionElement = document.getElementById("profileDescription"); 
    if (titleElement) 
    { titleElement.textContent = title; } 
    if (descriptionElement) 
    { descriptionElement.textContent = description; } 
    } 
</script>