@{
    ViewData["Title"] = "Profile";
}

<link rel="stylesheet" href="~/css/patient/PatientProfile.css" />
<link rel="stylesheet" href="~/css/site.css" />



<div class="profile-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-top">
            <a hx-get="/Patient/PatientProfile/Settings" hx-target="#profileContent">Settings</a>
        </div>

        <nav class="sidebar-nav">
            <a hx-get="/Patient/PatientProfile/ProfileInfo" hx-target="#profileContent" hx-trigger="click" class="active">Profile Info</a>
            <a hx-get="/Patient/PatientProfile/MedicalHistory" hx-target="#profileContent" hx-trigger="click">Medical History</a>
            <a hx-get="/Patient/PatientProfile/EmergencyContacts" hx-target="#profileContent" hx-trigger="click">Emergency Contacts</a>
            <a hx-get="/Patient/PatientProfile/DoctorInfo" hx-target="#profileContent" hx-trigger="click">Doctor Info</a>
            <a hx-get="/Patient/PatientProfile/ChangePassword" hx-target="#profileContent" hx-trigger="click">Change Password</a>
        </nav>

        <div class="sidebar-bottom">
            <a href="/Account/Logout">Logout</a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="profile-content" id="profileContent"
          hx-get="/Patient/PatientProfile/ProfileInfo"
          hx-trigger="load">
        <!-- Default placeholder until HTMX loads Profile Info -->
        <p>Loading profile information...</p>
    </main>
</div>
