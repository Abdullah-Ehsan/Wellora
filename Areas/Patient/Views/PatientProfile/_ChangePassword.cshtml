@model Wellora.Areas.Patient.ViewModels.PatientProfile.ChangePasswordViewModel

<div class="card">
    <h2>Change Password</h2>
    <form hx-post="/Patient/PatientProfile/ChangePassword" hx-target="#profileContent">
        <div>
            <label for="OldPassword">Current Password</label>
            <input type="password" id="OldPassword" name="OldPassword" value="@Model.OldPassword" />
        </div>
        <div>
            <label for="NewPassword">New Password</label>
            <input type="password" id="NewPassword" name="NewPassword" value="@Model.NewPassword" />
        </div>
        <div>
            <label for="ConfirmPassword">Confirm New Password</label>
            <input type="password" id="ConfirmPassword" name="ConfirmPassword" value="@Model.ConfirmPassword" />
        </div>
        <button type="submit" class="btn-teal">Update Password</button>
    </form>
</div>
