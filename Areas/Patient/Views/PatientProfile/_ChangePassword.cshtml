@model Wellora.Areas.Patient.ViewModels.PatientProfile.ChangePasswordViewModel

<link rel="stylesheet"
      href="~/css/patient/profile/change_password.css"
      asp-append-version="true" />

<div class="patient-change-password">

    <form method="post"
          hx-post="@Url.Action(
                                  "ChangePassword",
                                  "PatientProfile",
                                  new { area = "Patient" }
                              )"
          hx-target="#profileContent"
          hx-swap="innerHTML"
          hx-indicator="#profileLoading">

        @Html.AntiForgeryToken()


        <!-- =========================================================
             PASSWORD CARD
             ========================================================= -->
        <div class="card patient-profile-card">

            <!-- =====================================================
                 CARD HEADER
                 ===================================================== -->
            <div class="card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="patient-section-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <div>

                        <h5 class="mb-1">
                            Change Password
                        </h5>

                        <small class="text-muted">
                            Update your password to keep your account secure.
                        </small>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 CARD BODY
                 ===================================================== -->
            <div class="card-body">

                <div class="row g-4">


                    <!-- =================================================
                         CURRENT PASSWORD
                         ================================================= -->
                    <div class="col-12">

                        <label for="OldPassword"
                               class="form-label">

                            Current Password

                        </label>

                        <div class="password-input-wrapper">

                            <input type="password"
                                   id="OldPassword"
                                   name="OldPassword"
                                   class="form-control password-input"
                                   autocomplete="current-password"
                                   placeholder="Enter your current password"
                                   value="@Model.OldPassword"
                                   required />

                            <button type="button"
                                    class="password-toggle"
                                    data-password-target="OldPassword"
                                    aria-label="Show current password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="OldPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =================================================
                         NEW PASSWORD
                         ================================================= -->
                    <div class="col-12 col-md-6">

                        <label for="NewPassword"
                               class="form-label">

                            New Password

                        </label>

                        <div class="password-input-wrapper">

                            <input type="password"
                                   id="NewPassword"
                                   name="NewPassword"
                                   class="form-control password-input"
                                   autocomplete="new-password"
                                   placeholder="Enter a new password"
                                   value="@Model.NewPassword"
                                   minlength="8"
                                   required />

                            <button type="button"
                                    class="password-toggle"
                                    data-password-target="NewPassword"
                                    aria-label="Show new password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =================================================
                         CONFIRM PASSWORD
                         ================================================= -->
                    <div class="col-12 col-md-6">

                        <label for="ConfirmPassword"
                               class="form-label">

                            Confirm New Password

                        </label>

                        <div class="password-input-wrapper">

                            <input type="password"
                                   id="ConfirmPassword"
                                   name="ConfirmPassword"
                                   class="form-control password-input"
                                   autocomplete="new-password"
                                   placeholder="Confirm your new password"
                                   value="@Model.ConfirmPassword"
                                   minlength="8"
                                   required />

                            <button type="button"
                                    class="password-toggle"
                                    data-password-target="ConfirmPassword"
                                    aria-label="Show confirmation password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =================================================
                         PASSWORD REQUIREMENTS
                         ================================================= -->
                    <div class="col-12">

                        <div class="password-requirements">

                            <div class="password-requirements-header">

                                <i class="bi bi-info-circle"></i>

                                <span>
                                    Password requirements
                                </span>

                            </div>


                            <ul class="password-requirements-list">

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>At least 8 characters</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>At least one uppercase letter</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>At least one number</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>At least one special character</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Must be different from your current password</span>
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 CARD FOOTER
                 ===================================================== -->
            <div class="card-footer">

                <div class="d-flex justify-content-end">

                    <button type="submit"
                            class="btn patient-password-save-button">

                        <i class="bi bi-shield-check me-2"></i>

                        Update Password

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>


<script>

    /*
     * =========================================================
     * PASSWORD VISIBILITY TOGGLE
     * =========================================================
     */

    document.addEventListener("click", function (event) {

        const toggle =
            event.target.closest(".password-toggle");

        if (!toggle) {
            return;
        }


        const targetId =
            toggle.dataset.passwordTarget;

        const input =
            document.getElementById(targetId);

        if (!input) {
            return;
        }


        const icon =
            toggle.querySelector("i");

        if (input.type === "password") {

            input.type = "text";

            if (icon) {
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            }

            toggle.setAttribute(
                "aria-label",
                "Hide password"
            );

        }
        else {

            input.type = "password";

            if (icon) {
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }

            toggle.setAttribute(
                "aria-label",
                "Show password"
            );

        }

    });

</script>
