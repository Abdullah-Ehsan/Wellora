@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Wellora</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/admin/AdminProfileMenu.css" />

    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />


    @RenderSection("Styles", required: false)

</head>
<body>
    <div class="container-fluid p-0">

        <!-- Header: Only visible when a Patient is logged in -->
        @if (User.Identity.IsAuthenticated && User.IsInRole("patient"))
                {
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                <div class="container-fluid">

                    <!-- Left: Logo + Website Name -->
                    <a class="navbar-brand d-flex align-items-center" asp-area="Patient" asp-controller="Patient" asp-action="PatientDashboard">
                        <img src="~/images/logo.png" alt="Logo" style="height:40px;" />
                        <span class="ms-2">Wellora</span>
                    </a>

                    <!-- Center: Navigation Links -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-area="Patient" asp-controller="Patient" asp-action="PatientDashboard">DashBoard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Patient" asp-controller="PatientProfile" asp-action="PatientProfile">Profile</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Patient" asp-controller="PatientAI" asp-action="Index">AI Chat</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Patient" asp-controller="DoctorInformation" asp-action="DoctorListing">Doctors</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Patient" asp-controller="MakeAppointment" asp-action="PatientAppointment">Appointments</a></li>
                    </ul>

                        <!-- Right: Profile Picture Dropdown -->
                        <div class="dropdown">

                            @{
                                var profilePicPath = User.Claims
                                .FirstOrDefault(c => c.Type == "ProfilePicturePath")?.Value;

                                var profilePic = string.IsNullOrWhiteSpace(profilePicPath)
                                ? Url.Content("~/User/Patient/Profile_Picture/Default.png")
                                : Url.Content("~/" + profilePicPath.TrimStart('/'));
                            }

                            <!-- Profile Picture Button -->
                            <button class="btn p-0 border-0 bg-transparent"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <img src="@Url.Content(profilePic)"
                                     alt="Profile"
                                     class="rounded-circle"
                                     style="height:40px;width:40px;object-fit:cover;" />

                            </button>


                            <!-- Profile Dropdown -->
                            <ul class="dropdown-menu dropdown-menu-end admin-profile-menu">

                                <!-- Night Mode -->
                                <li>
                                    <partial name="_ThemeToggle" />
                                </li>



                                <!-- Divider -->
                                <li>
                                    <hr class="dropdown-divider">
                                </li>


                                <!-- Logout -->
                                <li>
                                    <partial name="_PatientLogout" />
                                </li>

                            </ul>

                        </div>
                </div>
            </nav>
        </header>
                }

        <!-- Main Content -->
        <main role="main" class="pb-0">
            @RenderBody()
        </main>

        <!-- Footer: Always visible -->
        <footer class="border-top bg-light text-muted py-3">
            <div class="container text-center">
                <p>&copy; 2025 - 2026 project | This is Wellora, the medical website for healthcare solutions.</p>
                <p>
                    <a asp-area="" asp-controller="Home" asp-action="About">About</a> |
                    <a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a> |
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> |
                </p>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/htmx.org/dist/htmx.min.js"></script>
    <script src="~/js/website_darkmode.js" asp-append-version="true"></script>
    <script src="~/lib/apexcharts/apexcharts.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
