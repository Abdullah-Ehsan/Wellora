@model Wellora.Areas.Patient.ViewModels.PatientDashboardViewModel

@{
    ViewData["Title"] = "Patient Dashboard";
}

<link rel="stylesheet"
      href="~/css/patient/PatientDashboard.css"
      asp-append-version="true">

<div class="dashboard-page-container container-fluid py-4 px-5">

    <!-- =========================================================
         PROFILE SUMMARY
    ========================================================== -->

    <div class="profile-summary-panel card border-0 shadow-sm p-4 mb-4 bg-white">

        <div class="row align-items-center">

            <div class="col-xl-3 col-lg-4 text-center mb-3 mb-lg-0">

                <img src="@(string.IsNullOrEmpty(Model.ProfilePhoto)
                                                   ? Url.Content("~/User/Patient/Profile_Picture/default.png")
                                                   : Url.Content("~/" + Model.ProfilePhoto))"
                     alt="Patient Profile"
                     class="dashboard-avatar-fixed" />

            </div>

            <div class="col-xl-9 col-lg-8">

                <div class="profile-header-meta">

                    <span class="badge badge-teal text-uppercase mb-2">
                        Patient Account Directory
                    </span>

                    <h1 class="display-5 font-weight-bold mb-1 text-dark">
                        @Model.FullName
                    </h1>

                    <p class="text-muted font-weight-bold mb-3"
                       style="font-size: 1.1rem;">

                        Patient ID:
                        <span class="text-teal">
                            #@Model.PatientId
                        </span>

                    </p>

                    <div class="row border-top pt-3 mt-2 grid-info-fields">

                        <div class="col-md-4 mb-2">

                            <span class="text-muted small d-block">
                                Username Handle
                            </span>

                            <strong>@@@Model.Username</strong>

                        </div>

                        <div class="col-md-4 mb-2">

                            <span class="text-muted small d-block">
                                Email Address
                            </span>

                            <strong>@Model.Email</strong>

                        </div>

                        <div class="col-md-2 mb-2">

                            <span class="text-muted small d-block">
                                Gender
                            </span>

                            <strong>@Model.Gender</strong>

                        </div>

                        <div class="col-md-2 mb-2">

                            <span class="text-muted small d-block">
                                Calculated Age
                            </span>

                            <strong>@Model.Age Years</strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         MAIN DASHBOARD ROW
    ========================================================== -->

    <div class="row mb-4">

        <!-- =====================================================
             LEFT COLUMN
        ====================================================== -->

        <div class="col-lg-6 mb-4 mb-lg-0 d-flex flex-column"
             style="gap: 20px;">

            <!-- =================================================
                 ANALYTICS SUMMARY
            ================================================== -->

            <div class="card border-0 shadow-sm p-4 bg-white">

                <h4 class="font-weight-bold text-dark border-bottom pb-2 mb-3 text-uppercase small tracking-wider">
                    Analytics & Trends Summary
                </h4>

                <div class="row text-center mt-2">

                    <div class="col-6 border-right py-2">

                        <span class="text-muted small d-block font-weight-bold text-uppercase">
                            Most Visited Doctor
                        </span>

                        <h6 class="font-weight-bold text-teal mt-1">
                            @Model.MostVisitedDoctor
                        </h6>

                    </div>

                    <div class="col-6 py-2">

                        <span class="text-muted small d-block font-weight-bold text-uppercase">
                            Highest Cost Consultation
                        </span>

                        <h6 class="font-weight-bold text-danger mt-1">
                            @Model.MostExpensiveDoctor
                        </h6>

                    </div>

                </div>

                <div class="bg-light rounded p-3 mt-4 text-center border">

                    <span class="text-muted text-uppercase small font-weight-bold d-block">
                        Total Treatment Investment
                    </span>

                    <span class="h2 font-weight-bold text-dark">
                        Rs. @Model.TotalExpenditure.ToString("F2")
                    </span>

                </div>

            </div>


            <!-- =================================================
                 APPOINTMENT VOLUME BAR CHART
            ================================================== -->

            <div class="card border-0 shadow-sm p-4 bg-white flex-grow-1">

                <h4 class="font-weight-bold text-dark border-bottom pb-2 mb-3 text-uppercase small tracking-wider">
                    Appointment Volume Trajectory
                </h4>

                <div class="dashboard-chart-container">

                    <canvas id="appointmentVolumeChart"></canvas>

                </div>

            </div>

        </div>


        <!-- =====================================================
             UPCOMING APPOINTMENTS
        ====================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm p-4 bg-white h-100">

                <h4 class="font-weight-bold text-dark border-bottom pb-2 mb-3 text-uppercase small tracking-wider">
                    Top 3 Upcoming Appointments
                </h4>

                @if (!Model.UpcomingAppointments.Any())
                {
                    <div class="text-center py-5">

                        <p class="text-muted font-weight-bold m-0">
                            No active appointments configured scheduled.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-striped appointment-dashboard-table m-0">

                            <thead>

                                <tr>
                                    <th>Image</th>
                                    <th>Doctor Name</th>
                                    <th>Specialty</th>
                                    <th>Date / Time</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var app in Model.UpcomingAppointments)
                                {
                                    <tr>

                                        <td>

                                            <img src="@(string.IsNullOrEmpty(app.DoctorPhoto)
                                                                                                           ? Url.Content("~/User/Doctor/Profile_Picture/default.png")
                                                                                                           : Url.Content("~/" + app.DoctorPhoto))"
                                         alt="Practitioner"
                                         class="dashboard-table-thumb" />

                                        </td>

                                        <td>

                                            <span class="font-weight-bold text-dark">
                                                Dr. @app.DoctorName
                                            </span>

                                        </td>

                                        <td>

                                            <span class="badge badge-light-teal font-weight-bold">
                                                @app.Specialization
                                            </span>

                                        </td>

                                        <td>

                                            <small class="d-block font-weight-bold text-dark">
                                                @app.AppointmentDate.ToString("dd/MM/yyyy")
                                            </small>

                                            <small class="text-muted">
                                                @app.AppointmentDate.ToString("hh:mm tt")
                                            </small>

                                        </td>

                                    </tr>
                                                        }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         CHARTS SECTION
         ABOVE CLINICAL PROFILE
    ========================================================== -->

    <div class="row mb-4">

        <!-- =====================================================
             APPOINTMENT STATUS
        ====================================================== -->

        <div class="col-lg-4 mb-4 mb-lg-0">

            <div class="card border-0 shadow-sm p-4 bg-white h-100">

                <h4 class="font-weight-bold text-dark border-bottom pb-2 mb-3 text-uppercase small tracking-wider">
                    Appointment Status
                </h4>

                <div class="dashboard-pie-chart-container">

                    <canvas id="appointmentStatusChart"></canvas>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PAYMENT STATUS
        ====================================================== -->

        <div class="col-lg-4 mb-4 mb-lg-0">

            <div class="card border-0 shadow-sm p-4 bg-white h-100">

                <h4 class="font-weight-bold text-dark border-bottom pb-2 mb-3 text-uppercase small tracking-wider">
                    Payment Status
                </h4>

                <div class="dashboard-pie-chart-container">

                    <canvas id="paymentStatusChart"></canvas>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PAYMENT METHOD
        ====================================================== -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm p-4 bg-white h-100">

                <h4 class="font-weight-bold text-dark border-bottom pb-2 mb-3 text-uppercase small tracking-wider">
                    Payment Methods
                </h4>

                <div class="dashboard-pie-chart-container">

                    <canvas id="paymentMethodChart"></canvas>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         CLINICAL ACCOUNT PROFILE
    ========================================================== -->

    <div class="card border-0 shadow-sm p-4 mb-4 bg-white">

        <h4 class="font-weight-bold text-dark border-bottom pb-2 mb-4 text-uppercase small tracking-wider">
            Clinical Account Specific Profile Data
        </h4>

        <div class="row">

            <div class="col-md-3 col-sm-6 mb-3">

                <span class="text-muted small d-block">
                    Blood Categorization
                </span>

                <span class="font-weight-bold text-teal h5 m-0">
                    @Model.BloodGroup
                </span>

            </div>


            <div class="col-md-3 col-sm-6 mb-3">

                <span class="text-muted small d-block">
                    Preferred Language
                </span>

                <span class="font-weight-bold text-dark">
                    @Model.PreferredLanguage
                </span>

            </div>


            <div class="col-md-3 col-sm-6 mb-3">

                <span class="text-muted small d-block">
                    Emergency Contact Name
                </span>

                <span class="font-weight-bold text-dark">
                    @Model.EmergencyContactName
                </span>

            </div>


            <div class="col-md-3 col-sm-6 mb-3">

                <span class="text-muted small d-block">
                    Emergency Contact Phone
                </span>

                <span class="font-weight-bold text-dark">
                    @Model.EmergencyContactPhone
                </span>

            </div>

        </div>


        <div class="row border-top pt-3 mt-2">

            <div class="col-md-4 mb-3">

                <span class="text-muted small d-block">
                    Configured Residential Address
                </span>

                <span class="font-weight-bold text-dark"
                      style="font-size:0.95rem;">
                    @Model.Address
                </span>

            </div>


            <div class="col-md-4 mb-3">

                <span class="text-muted small d-block">
                    Allergies Profile Ledger
                </span>

                <span class="font-weight-bold text-danger"
                      style="font-size:0.95rem;">
                    @Model.Allergies
                </span>

            </div>


            <div class="col-md-4 mb-3">

                <span class="text-muted small d-block">
                    Active Diagnosed Medical Conditions
                </span>

                <span class="font-weight-bold text-dark"
                      style="font-size:0.95rem;">
                    @Model.MedicalConditions
                </span>

            </div>

        </div>

    </div>


    <!-- =========================================================
         TIMELINE FOOTER
    ========================================================== -->

    <div class="dashboard-timeline-footer border-top pt-3 d-flex justify-content-between text-muted small px-2">

        <span>

            Account First Enrolled Date:

            <strong>
                @(Model.CreatedAt?.ToString("dd/MM/yyyy hh:mm tt")
                                ?? "Initial Synchronization Setup")
            </strong>

        </span>


        <span>

            Account Profile Latest Update Footprint:

            <strong>
                @(Model.UpdatedAt?.ToString("dd/MM/yyyy hh:mm tt")
                                ?? "No Modifying Adjustments Made")
            </strong>

        </span>

    </div>

</div>


<!-- =============================================================
     CHART.JS
============================================================== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        /*
         * ========================================================
         * THEME COLORS
         * ========================================================
         *
         * These values come directly from theme.css.
         *
         * We do NOT hard-code the teal colors here.
         * Therefore your existing theme remains the source of truth.
         */

        const root = getComputedStyle(document.documentElement);

        const primary = root.getPropertyValue("--primary").trim();
        const teal300 = root.getPropertyValue("--teal-300").trim();
        const teal500 = root.getPropertyValue("--teal-500").trim();
        const teal700 = root.getPropertyValue("--teal-700").trim();

        const success = root.getPropertyValue("--success").trim();
        const warning = root.getPropertyValue("--warning").trim();
        const danger = root.getPropertyValue("--danger").trim();

        const gray700 = root.getPropertyValue("--gray-700").trim();


        /*
         * ========================================================
         * DARK MODE
         * ========================================================
         */

        const isDarkMode =
            document.documentElement.classList.contains("dark") ||
            document.body.classList.contains("dark");


        /*
         * Chart text colors
         */

        const chartTextColor = isDarkMode
            ? "#d1d5db"
            : gray700;


        /*
         * Chart grid colors
         */

        const chartGridColor = isDarkMode
            ? "rgba(255,255,255,0.08)"
            : "rgba(0,0,0,0.06)";


        /*
         * ========================================================
         * GLOBAL CHART DEFAULTS
         * ========================================================
         */

        Chart.defaults.color = chartTextColor;

        Chart.defaults.font.family =
            getComputedStyle(document.body).fontFamily || "Arial";


        /*
         * ========================================================
         * APPOINTMENT VOLUME BAR CHART
         * ========================================================
         */

        const appointmentVolumeCanvas =
            document.getElementById("appointmentVolumeChart");

        if (appointmentVolumeCanvas) {

            const labels =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.AppointmentChartLabels
                                ));

            const data =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.AppointmentChartData
                                ));


            new Chart(appointmentVolumeCanvas, {

                type: "bar",

                data: {

                    labels: labels,

                    datasets: [

                        {
                            label: "Appointments",

                            data: data,

                            backgroundColor: primary,

                            borderColor: teal700,

                            borderWidth: 1,

                            borderRadius: 6,

                            maxBarThickness: 45
                        }

                    ]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        },

                        tooltip: {

                            backgroundColor: isDarkMode
                                ? "#111827"
                                : "#ffffff",

                            titleColor: isDarkMode
                                ? "#ffffff"
                                : "#111827",

                            bodyColor: isDarkMode
                                ? "#d1d5db"
                                : "#374151",

                            borderColor: primary,

                            borderWidth: 1

                        }

                    },


                    scales: {

                        x: {

                            grid: {
                                display: false
                            },

                            ticks: {
                                color: chartTextColor
                            }

                        },


                        y: {

                            beginAtZero: true,

                            ticks: {

                                precision: 0,

                                color: chartTextColor

                            },

                            grid: {

                                color: chartGridColor

                            }

                        }

                    }

                }

            });

        }


        /*
         * ========================================================
         * APPOINTMENT STATUS DOUGHNUT
         * ========================================================
         */

        const appointmentStatusCanvas =
            document.getElementById("appointmentStatusChart");

        if (appointmentStatusCanvas) {

            const labels =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.AppointmentStatusLabels
                                ));

            const data =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.AppointmentStatusData
                                ));


            new Chart(appointmentStatusCanvas, {

                type: "doughnut",

                data: {

                    labels: labels,

                    datasets: [

                        {

                            data: data,

                            backgroundColor: [

                                primary,
                                success,
                                danger

                            ],

                            borderColor: isDarkMode
                                ? "#111827"
                                : "#ffffff",

                            borderWidth: 3,

                            hoverOffset: 8

                        }

                    ]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "62%",

                    plugins: {

                        legend: {

                            position: "bottom",

                            labels: {

                                color: chartTextColor,

                                padding: 18,

                                usePointStyle: true

                            }

                        }

                    }

                }

            });

        }


        /*
         * ========================================================
         * PAYMENT STATUS DOUGHNUT
         * ========================================================
         */

        const paymentStatusCanvas =
            document.getElementById("paymentStatusChart");

        if (paymentStatusCanvas) {

            const labels =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.PaymentStatusLabels
                                ));

            const data =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.PaymentStatusData
                                ));


            new Chart(paymentStatusCanvas, {

                type: "doughnut",

                data: {

                    labels: labels,

                    datasets: [

                        {

                            data: data,

                            backgroundColor: [

                                success,
                                warning,
                                danger,
                                teal700

                            ],

                            borderColor: isDarkMode
                                ? "#111827"
                                : "#ffffff",

                            borderWidth: 3,

                            hoverOffset: 8

                        }

                    ]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "62%",

                    plugins: {

                        legend: {

                            position: "bottom",

                            labels: {

                                color: chartTextColor,

                                padding: 15,

                                usePointStyle: true

                            }

                        }

                    }

                }

            });

        }


        /*
         * ========================================================
         * PAYMENT METHOD DOUGHNUT
         * ========================================================
         */

        const paymentMethodCanvas =
            document.getElementById("paymentMethodChart");

        if (paymentMethodCanvas) {

            const labels =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.PaymentMethodLabels
                                ));

            const data =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Model.PaymentMethodData
                                ));


            new Chart(paymentMethodCanvas, {

                type: "doughnut",

                data: {

                    labels: labels,

                    datasets: [

                        {

                            data: data,

                            backgroundColor: [

                                primary,
                                teal300,
                                teal700

                            ],

                            borderColor: isDarkMode
                                ? "#111827"
                                : "#ffffff",

                            borderWidth: 3,

                            hoverOffset: 8

                        }

                    ]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "62%",

                    plugins: {

                        legend: {

                            position: "bottom",

                            labels: {

                                color: chartTextColor,

                                padding: 18,

                                usePointStyle: true

                            }

                        }

                    }

                }

            });

        }

    });

</script>
