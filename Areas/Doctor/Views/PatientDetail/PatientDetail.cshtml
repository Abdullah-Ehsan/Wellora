@model Wellora.ViewModels.PatientDetail.PatientDetailViewModel
@{
    ViewBag.Title = "Patient Detail";
}

<link rel="stylesheet" href="~/css/doctor/PatientDetail.css" />

<div class="container mt-4">
    <!-- Patient Header -->
    <div class="row">
        <div class="col-md-3 text-center">
            <img src="@(string.IsNullOrEmpty(@Model.Patient.ProfilePhoto)
                   ? Url.Content("~/User/Patient/Profile_Picture/Default.png")
                       : Url.Content("~/" + @Model.Patient.ProfilePhoto))"
                            class="patient-photo" />
        </div>
        <div class="col-md-9">
            <h2 class="patient-section-title">@Model.Patient.FullName</h2>
            <p><strong>Gender:</strong> @Model.Patient.Gender</p>
            <p><strong>DOB:</strong> @Model.Patient.DateOfBirth</p>
            <p><strong>Age:</strong> @Model.Age</p>
        </div>
    </div>

    <!-- Current Appointment -->
    <h4 class="patient-section-title">Current Appointment</h4>
    <div class="appointment-card">
        <p><strong>ID:</strong> @Model.CurrentAppointment.AppointmentId</p>
        <p><strong>Date:</strong> @Model.CurrentAppointment.AppointmentDate.ToString("dddd, dd MMM yyyy hh:mm tt")</p>
    </div>

    <!-- Primary Doctor -->
    <h4 class="patient-section-title">Primary Doctor</h4>

    <div class="primary-doctor-card">

        @if (Model.PrimaryDoctor != null && Model.PrimaryDoctor.Exists)
        {
            <div class="primary-doctor-content">

                <!-- Doctor Picture -->
                <div class="primary-doctor-photo-container">
                    <img src="@(string.IsNullOrEmpty(Model.PrimaryDoctor.ProfilePhoto)
                                             ? Url.Content("~/User/Doctor/Profile_Picture/default.png")
                                             : Url.Content("~/" + Model.PrimaryDoctor.ProfilePhoto))"
                     alt="Primary Doctor"
                     class="primary-doctor-photo" />
            </div>

                <!-- Doctor Information -->
                <div class="primary-doctor-info">

                    <h3>@Model.PrimaryDoctor.DoctorName</h3>

                @if (Model.PrimaryDoctor.IsOutsideDoctor)
                    {
                        <span class="doctor-source outside-doctor-source">
                            Doctor from another hospital / foreign medical system
                        </span>
                    }
                    else
                    {
                        <span class="doctor-source wellora-doctor-source">
                            Doctor from Wellora Doctor Catalog
                        </span>
                    }

                <p>
                    <strong>Specialty:</strong>
                    @(string.IsNullOrEmpty(Model.PrimaryDoctor.Specialty)
                                        ? "Not provided"
                                        : Model.PrimaryDoctor.Specialty)
                                                                    </p>

                <p>
                    <strong>Contact:</strong>
                    @(string.IsNullOrEmpty(Model.PrimaryDoctor.ContactNumber)
                                        ? "Not provided"
                                        : Model.PrimaryDoctor.ContactNumber)
                </p>

                @if (Model.PrimaryDoctor.IsOutsideDoctor)
                    {
                        <p>
                            <strong>Hospital:</strong>
                            @(string.IsNullOrEmpty(Model.PrimaryDoctor.HospitalName)
                                                ? "Not provided"
                                                : Model.PrimaryDoctor.HospitalName)
                </p>
                                }

                <p>
                    <strong>
                        @(Model.PrimaryDoctor.IsOutsideDoctor
                                                ? "Hospital Location:"
                                                : "Hospital Address:")
                                                                  </strong>

                    @(string.IsNullOrEmpty(Model.PrimaryDoctor.HospitalAddress)
                                        ? "Not provided"
                                        : Model.PrimaryDoctor.HospitalAddress)
                </p>

                </div>
            </div>
                }
        else
        {
            <div class="no-primary-doctor">
                <p>
                    This patient does not have a current primary doctor.
                </p>
            </div>
        }

    </div>

    


    <!-- Previous Appointments -->
    <h4 class="patient-section-title">Previous Appointments</h4>
    <div class="appointments-container">
        @if (!Model.PreviousAppointments.Any())
        {
            <div class="row w-100">
                <div class="col-md-6 text-center">
                    <img src="~/images/Patient/Appointment/no_appointment.png"
                         style="width:598px;height:939px;" />
                </div>
                <div class="col-md-6 d-flex align-items-center justify-content-center no-appointments-box">
                    <p>The patient has no previous appointments.</p> <br />
                    <p>This is the first one.</p>
                </div>

            </div>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Payment</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < 10; i++)
                    {
                        if (i < Model.PreviousAppointments.Count)
                        {
                            var appt = Model.PreviousAppointments[i];
                            <tr>
                                <td>@appt.AppointmentId</td>
                                <td>@appt.AppointmentDate.ToString("dddd, dd MMM yyyy")</td>
                                <td>@appt.AppointmentDate.ToString("hh:mm tt")</td>
                                <td>@appt.Status</td>
                                <td>@appt.PaymentStatus</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-muted">Placeholder</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="mt-3">
        <p>Total Appointments: @Model.TotalAppointments</p>
        @if (Model.LastAppointment != null)
        {
            <p>
                Last Appointment: @Model.LastAppointment.AppointmentDate.ToString("dddd, dd MMM yyyy hh:mm tt") <br />
                Time Passed: @Model.LastAppointmentTimePassed
            </p>
        }
    </div>

    <!-- Important Info -->
    <h4 class="patient-section-title">Important Info</h4>
    <p><strong>Blood Group:</strong> @(string.IsNullOrEmpty(Model.Patient.BloodGroup) ? "Not discovered" : Model.Patient.BloodGroup)</p>
    <p><strong>Allergies:</strong> @(string.IsNullOrEmpty(Model.Patient.Allergies) ? "None" : Model.Patient.Allergies)</p>
    <p><strong>Medical Conditions:</strong> @(string.IsNullOrEmpty(Model.Patient.MedicalConditions) ? "None" : Model.Patient.MedicalConditions)</p>
    <p><strong>Medications:</strong> @(string.IsNullOrEmpty(Model.Patient.Medications) ? "None" : Model.Patient.Medications)</p>
    <p><strong>Address:</strong> @(string.IsNullOrEmpty(Model.Patient.Address) ? "Not provided" : Model.Patient.Address)</p>
    <p><strong>Emergency Contact:</strong> @(string.IsNullOrEmpty(Model.Patient.EmergencyContactName) ? "Not provided" : Model.Patient.EmergencyContactName) - @(string.IsNullOrEmpty(Model.Patient.EmergencyContactPhone) ? "Not provided" : Model.Patient.EmergencyContactPhone)</p>
    <p><strong>Preferred Language:</strong> @(string.IsNullOrEmpty(Model.Patient.PreferredLanguage) ? "Not provided" : Model.Patient.PreferredLanguage)</p>

    <!-- Confirmation -->
    <div class="confirmation-section mt-4">

        <h4 class="patient-section-title">Confirmation</h4>

        <div class="confirmation-card">

            <!-- Appointment Acceptance -->
            <div class="confirmation-group">
                <h5 class="confirmation-group-title">
                    Appointment Acceptance
                </h5>

                <div class="appointment-action-row">

                    <!-- Confirm -->
                    <form asp-area="Doctor"
                          asp-controller="PatientDetail"
                          asp-action="ConfirmAppointment"
                          method="post">

                        <input type="hidden"
                               name="appointmentId"
                               value="@Model.CurrentAppointment.AppointmentId" />

                        <input type="hidden"
                               name="patientId"
                               value="@Model.Patient.PatientId" />

                        <button type="submit"
                                class="appointment-action-btn confirm-btn"
                                @(Model.AppointmentActions.CanConfirm ? "" : "disabled")>

                            <span class="action-icon">✓</span>
                            <span>Confirm Appointment</span>

                        </button>
                    </form>


                    <!-- Cancel -->
                    <form asp-area="Doctor"
                          asp-controller="PatientDetail"
                          asp-action="CancelAppointment"
                          method="post">

                        <input type="hidden"
                               name="appointmentId"
                               value="@Model.CurrentAppointment.AppointmentId" />

                        <input type="hidden"
                               name="patientId"
                               value="@Model.Patient.PatientId" />

                        <button type="submit"
                                class="appointment-action-btn cancel-btn"
                                @(Model.AppointmentActions.CanCancel ? "" : "disabled")>

                            <span class="action-icon">×</span>
                            <span>Cancel Appointment</span>

                        </button>
                    </form>

                </div>
            </div>


            <!-- Payment -->
            <div class="confirmation-group payment-group">

                <h5 class="confirmation-group-title">
                    Payment Status
                </h5>

                @if (Model.CurrentAppointment.PaymentStatus == "paid")
                {
                    <div class="payment-status paid-status">
                        <span class="payment-icon">✓</span>

                        <div>
                            <strong>Paid</strong>
                            <small>Payment has already been completed.</small>
                        </div>
                    </div>
                }
                else if (Model.CurrentAppointment.PaymentStatus == "pending")
                {
                    <form asp-area="Doctor"
                          asp-controller="PatientDetail"
                          asp-action="MarkPaymentPaid"
                          method="post">

                        <input type="hidden"
                               name="appointmentId"
                               value="@Model.CurrentAppointment.AppointmentId" />

                        <input type="hidden"
                               name="patientId"
                               value="@Model.Patient.PatientId" />

                        <button type="submit"
                                class="appointment-action-btn payment-btn"
                                @(Model.AppointmentActions.CanMarkPaid ? "" : "disabled")>

                            <span class="action-icon">✓</span>
                            <span>Mark as Paid</span>

                        </button>
                    </form>
                }
                else
                {
                    <div class="payment-status pending-status">
                        <span class="payment-icon">!</span>

                        <div>
                            <strong>
                                @Model.CurrentAppointment.PaymentStatus
                            </strong>

                            <small>
                                Payment status cannot be changed.
                            </small>
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>


</div>
