@model Wellora.Areas.Doctor.ViewModels.DoctorProfile.DoctorDetailsViewModel

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title mb-4">Clinical Information</h5>

        <form asp-action="UpdateClinicalInfo" asp-controller="DoctorProfile" method="post">
            <input type="hidden" asp-for="DoctorId" />

            <div class="row">
                <!-- Hospital Address -->
                <div class="col-md-6 mb-3">
                    <label asp-for="HospitalAddress" class="form-label">Hospital Address</label>
                    <textarea asp-for="HospitalAddress" class="form-control" rows="2"></textarea>
                </div>

                <!-- Country -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Country" class="form-label">Country</label>
                    <input asp-for="Country" class="form-control" />
                </div>
            </div>

            <div class="row">
                <!-- License Number -->
                <div class="col-md-6 mb-3">
                    <label asp-for="LicenseNumber" class="form-label">License Number</label>
                    <input asp-for="LicenseNumber" class="form-control" />
                </div>

                <!-- PMDC Number -->
                <div class="col-md-6 mb-3">
                    <label asp-for="PmdcNumber" class="form-label">PMDC Number</label>
                    <input asp-for="PmdcNumber" class="form-control" />
                </div>
            </div>

            <div class="row">
                <!-- Medical School -->
                <div class="col-md-6 mb-3">
                    <label asp-for="MedicalSchool" class="form-label">Medical School</label>
                    <input asp-for="MedicalSchool" class="form-control" />
                </div>

                <!-- Certifications -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Certifications" class="form-label">Certifications</label>
                    <textarea asp-for="Certifications" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="row">
                <!-- Consultation Fee -->
                <div class="col-md-6 mb-3">
                    <label asp-for="ConsultationFee" class="form-label">Consultation Fee</label>
                    <input asp-for="ConsultationFee" class="form-control" type="number" min="0" step="100" />
                </div>

                <!-- Telemedicine Available -->
                <div class="col-md-6 mb-3 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <input asp-for="TelemedicineAvailable" class="form-check-input" type="checkbox" />
                        <label asp-for="TelemedicineAvailable" class="form-check-label">Telemedicine Available</label>
                    </div>
                </div>
            </div>

            <!-- Save Button -->
            <div class="text-end">
                <button type="submit" class="btn btn-primary">
                    💾 Save Clinical Info
                </button>
            </div>
        </form>
    </div>
</div>
