@model Wellora.Areas.Doctor.ViewModels.DoctorProfile.ChangePasswordViewModel

<link rel="stylesheet" href="~/css/doctor/profile/doctor_profile_password.css" />



<div class="doctor-password-card">

    <div class="doctor-password-header">

        <div class="doctor-password-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <div>
            <h5 class="doctor-password-title">
                Change Password
            </h5>

            <p class="doctor-password-description mb-0">
                Update your account password to keep your account secure.
            </p>
        </div>

    </div>


    <form asp-action="ChangePassword"
          asp-controller="DoctorProfile"
          asp-area="Doctor"
          method="post"
          class="doctor-password-form">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="doctor-password-validation">
        </div>


        <!-- =========================
             CURRENT PASSWORD
        ========================== -->

        <div class="doctor-password-field">

            <label asp-for="OldPassword"
                   class="form-label">
                Current Password
            </label>

            <div class="doctor-password-input-wrapper">

                <input asp-for="OldPassword"
                       id="OldPassword"
                       class="form-control doctor-password-input"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Enter your current password" />

                <button type="button"
                        class="doctor-password-toggle"
                        onclick="togglePassword('OldPassword', 'oldPasswordIcon')"
                        aria-label="Show current password">

                    <i id="oldPasswordIcon"
                       class="bi bi-eye-slash"></i>

                </button>

            </div>

            <span asp-validation-for="OldPassword"
                  class="doctor-password-error">
            </span>

        </div>


        <!-- =========================
             NEW PASSWORD
        ========================== -->

        <div class="doctor-password-field">

            <label asp-for="NewPassword"
                   class="form-label">
                New Password
            </label>

            <div class="doctor-password-input-wrapper">

                <input asp-for="NewPassword"
                       id="NewPassword"
                       class="form-control doctor-password-input"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Enter your new password"
                       oninput="validatePassword('NewPassword', 'newPasswordError')" />

                <button type="button"
                        class="doctor-password-toggle"
                        onclick="togglePassword('NewPassword', 'newPasswordIcon')"
                        aria-label="Show new password">

                    <i id="newPasswordIcon"
                       class="bi bi-eye-slash"></i>

                </button>

            </div>

            <span id="newPasswordError"
                  class="doctor-password-error">
            </span>

            <span asp-validation-for="NewPassword"
                  class="doctor-password-error">
            </span>

        </div>


        <!-- =========================
             CONFIRM PASSWORD
        ========================== -->

        <div class="doctor-password-field">

            <label asp-for="ConfirmPassword"
                   class="form-label">
                Confirm New Password
            </label>

            <div class="doctor-password-input-wrapper">

                <input asp-for="ConfirmPassword"
                       id="ConfirmPassword"
                       class="form-control doctor-password-input"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Confirm your new password" />

                <button type="button"
                        class="doctor-password-toggle"
                        onclick="togglePassword('ConfirmPassword', 'confirmPasswordIcon')"
                        aria-label="Show confirmed password">

                    <i id="confirmPasswordIcon"
                       class="bi bi-eye-slash"></i>

                </button>

            </div>

            <span asp-validation-for="ConfirmPassword"
                  class="doctor-password-error">
            </span>

        </div>


        <!-- =========================
             PASSWORD REQUIREMENTS
        ========================== -->

        <div class="doctor-password-hint">

            <i class="bi bi-info-circle"></i>

            <span>
                Password must be at least 8 characters and include an
                uppercase letter, a number, and a special character.
            </span>

        </div>


        <!-- =========================
             SAVE
        ========================== -->

        <div class="doctor-password-actions">

            <button type="submit"
                    class="btn btn-primary doctor-password-save">

                <i class="bi bi-shield-check"></i>

                Save Password

            </button>

        </div>

    </form>

</div>


<script src="~/js/input_validation.js"></script>