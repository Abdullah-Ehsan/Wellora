@model Wellora.Areas.Doctor.ViewModels.DoctorProfile.DoctorDetailsViewModel

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title mb-4">Achievements & Biography</h5>

        <form asp-action="UpdateAchievements" asp-controller="DoctorProfile" method="post">
            <input type="hidden" asp-for="DoctorId" />

            <div class="row">
                <!-- Achievements -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Achievements" class="form-label">Achievements</label>
                    <textarea asp-for="Achievements" class="form-control" rows="4" placeholder="List your career highlights"></textarea>
                </div>

                <!-- Publications -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Publications" class="form-label">Publications</label>
                    <textarea asp-for="Publications" class="form-control" rows="4" placeholder="Add research papers or articles"></textarea>
                </div>
            </div>

            <!-- Biography -->
            <div class="mb-3">
                <label asp-for="Biography" class="form-label">Biography</label>
                <textarea asp-for="Biography" class="form-control" rows="6" placeholder="Write a short professional biography"></textarea>
            </div>

            <!-- Save Button -->
            <div class="text-end">
                <button type="submit" class="btn btn-primary">
                    💾 Save Achievements & Biography
                </button>
            </div>
        </form>
    </div>
</div>
