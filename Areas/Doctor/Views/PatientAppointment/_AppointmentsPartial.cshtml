@model IEnumerable<Wellora.Areas.Doctor.ViewModels.PatientAppointment.PatientAppointmentListViewModel>

<div class="appointment-list d-flex flex-column gap-2">
    @foreach (var appt in Model)
    {
        <div class="appointment-row row align-items-center g-0 px-3 py-2">

            <!-- PHOTO -->
            <div class="col-auto">
                <img src="@(string.IsNullOrEmpty(appt.ProfilePhoto)
                                     ? Url.Content("~/User/Patient/Profile_Picture/Default.png")
                                     : Url.Content("~/" + appt.ProfilePhoto))"
                 class="patient-photo"
                 alt="@appt.PatientName" />
        </div>

            <!-- NAME -->
            <div class="col name-col ps-3">
                <div class="fw-bold">
                    @appt.PatientName
                </div>
            </div>

            <!-- GENDER -->
            <div class="col">
                <div class="small text-muted">
                    Gender
                </div>
                <div>
                    @appt.Gender
                </div>
            </div>

            <!-- AGE -->
            <div class="col">
                <div class="small text-muted">
                    Age
                </div>
                <div>
                    @appt.Age
                </div>
            </div>

            <!-- LAST APPOINTMENT -->
            <div class="col">
                <div class="small text-muted">
                    Last
                </div>

            @if (appt.IsFirstAppointment)
                {
                    <div class="small" style="color:#057741;">
                        First Appointment
                    </div>
                }
                else
                {
                    <div class="text-muted small">
                        Last: @appt.LastVisitedDate?.ToString("dd MMM yyyy")
                    </div>
                }
            </div>

            <!-- UPCOMING -->
            <div class="col">
                <div class="small text-muted">
                    Upcoming
                </div>

                <div>
                    @appt.AppointmentDate.ToString("dd MMM yyyy hh:mm tt")
                </div>
            </div>

            <!-- VIEW -->
            <div class="col-auto text-end">

                <a asp-action="PatientDetail"
                   asp-controller="PatientDetail"
                   asp-area="Doctor"
                   asp-route-patientId="@appt.PatientId"
                   asp-route-appointmentId="@appt.AppointmentId"
                   class="view-link btn btn-sm btn-primary">
                    View
                </a>

            </div>

        </div>
    }

</div> <!-- ========================================================= PAGINATION ========================================================= -->
@if (ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-center mt-4">

        <nav aria-label="Appointment pagination">

            <ul class="pagination">

                @{
                    int totalPages = ViewBag.TotalPages;
                    int currentPage = ViewBag.CurrentPage;

                    int startPage;
                    int endPage;

                    // ---------------------------------------------
                    // Show maximum 3 page numbers
                    //
                    // Page 1 → 1 2 3
                    // Page 2 → 1 2 3
                    // Page 3 → 2 3 4
                    // Page 4 → 3 4 5
                    // ---------------------------------------------

                    if (currentPage <= 2)
                    {
                        startPage = 1;
                        endPage = Math.Min(3, totalPages);
                    }
                    else
                    {
                        startPage = currentPage - 1;
                        endPage = Math.Min(
                        currentPage + 1,
                        totalPages);
                    }

                    for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">

                            <a class="page-link @(i == currentPage ? "active" : "")"
                               href="javascript:void(0);"
                               hx-get="@Url.Action(
                                                              "PatientAppointmentList",
                                                              "PatientAppointment",
                                                              new
                                                              {
                                                                  area = "Doctor",
                                                                  page = i,
                                                                  gender = ViewBag.Gender
                                                              })"
                   hx-target="#appointments-list"
                   hx-swap="innerHTML">

                                @i

                            </a>

                        </li>
                        }
                }

            </ul>

        </nav>

    </div>


}